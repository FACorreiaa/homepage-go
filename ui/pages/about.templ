package pages

import (
	"myapp/ui/layouts"
	"myapp/ui/modules"
)

templ About() {
	@layouts.BaseLayout(layouts.LayoutProps{Title: "About | FC Software Studio", ActivePage: "about", Description: "Fernando Correia is a Portugal-based software engineer building web apps, native iOS products, backend systems, and small product infrastructure."}) {
		<div class="public-shell min-h-screen">
			<section class="mx-auto max-w-7xl px-4 py-20 md:py-32">
				<div class="grid gap-12 lg:grid-cols-[0.62fr_0.38fr] lg:items-end">
					<div>
						<p class="font-mono text-xs tracking-[0.18em] text-muted-foreground">FERNANDO CORREIA / PRODUCT ENGINEERING</p>
						<h1 class="hero-title mt-6 max-w-5xl font-semibold">
							I turn ambiguous product work into shipped software.
						</h1>
						<p class="mt-8 max-w-2xl text-xl leading-9 text-muted-foreground">I build FC Software Studio around senior backend, web, and iOS product engineering for teams that need practical execution and finished systems.</p>
						<div class="mt-10 flex flex-wrap gap-3">
							<a href="/proposal" class="inline-flex items-center gap-2 rounded-full bg-foreground px-6 py-3 text-sm font-semibold text-background transition-opacity hover:opacity-90 active:scale-[0.99]">
								Request proposal
								@modules.UIIcon("arrow-right", "h-4 w-4")
							</a>
							<a href="mailto:fernandocorreia316@gmail.com" class="inline-flex items-center gap-2 rounded-full border border-border px-6 py-3 text-sm font-semibold transition-colors hover:bg-accent active:scale-[0.99]">
								Email me
								@modules.UIIcon("mail", "h-4 w-4")
							</a>
						</div>
					</div>
					<aside class="public-card rounded-lg p-6 md:p-7">
						<div class="flex items-center gap-4 border-b border-border pb-6">
							<div class="grid h-16 w-16 place-items-center rounded-2xl bg-foreground font-semibold text-background">FC</div>
							<div>
								<h2 class="text-2xl font-semibold">Fernando Correia</h2>
								<p class="mt-1 text-sm text-muted-foreground">Software engineer, Portugal</p>
							</div>
						</div>
						<div class="mt-6 space-y-3">
							@aboutInfoRow("mail", "Email", "fernandocorreia316@gmail.com")
							@aboutInfoRow("calendar", "Availability", "Remote projects and product consulting")
							@aboutInfoRow("github", "GitHub", "github.com/FACorreiaa")
						</div>
					</aside>
				</div>
			</section>
			<section class="mx-auto max-w-7xl px-4 py-20 md:py-32" data-motion="pinned-split">
				<div class="grid gap-12 lg:grid-cols-[0.34fr_0.66fr]">
					<div data-motion-pin>
						<h2 class="section-title font-semibold">Operating principles</h2>
						<p class="mt-6 text-lg leading-8 text-muted-foreground">The work is pragmatic: understand the system, shape the smallest useful path, then ship with a bias for maintainability.</p>
					</div>
					<div class="grid grid-flow-dense gap-px overflow-hidden rounded-lg bg-border md:grid-cols-2" data-motion-track>
						for _, v := range [][]string{{"Collaboration","Complex systems get better when product, engineering, and operations stay close."},{"Problem shaping","The first useful deliverable is often a sharper definition of the problem."},{"Modern delivery","Go, Swift, HTMX, Docker, and Postgres are chosen when they reduce operational drag."},{"Finish quality","Polish is not decoration. It is clarity, latency, reliability, and fewer rough edges."}} {
							<div class="bg-card p-8">
								<h3 class="text-2xl font-semibold">{ v[0] }</h3>
								<p class="mt-4 text-sm leading-6 text-muted-foreground">{ v[1] }</p>
							</div>
						}
					</div>
				</div>
			</section>
			<section class="mx-auto max-w-7xl px-4 pb-32 md:pb-48">
				<div class="grid gap-px overflow-hidden rounded-lg bg-border md:grid-cols-4">
					for _, s := range [][]string{{"7+","Years experience"},{"15+","Projects delivered"},{"10+","Core technologies"},{"4","Countries"}} {
						<div class="bg-background p-8 text-center">
							<div class="text-5xl font-semibold tabular-nums">{ s[0] }</div>
							<div class="mt-2 text-sm text-muted-foreground">{ s[1] }</div>
						</div>
					}
				</div>
				<div class="mt-12 grid gap-4 md:grid-cols-[1.1fr_0.9fr]">
					<div class="public-card rounded-lg p-7 md:p-8">
						<h2 class="text-3xl font-semibold">Best way to reach me</h2>
						<p class="mt-4 max-w-2xl text-base leading-7 text-muted-foreground">For project work, use the proposal form so I can understand context, timeline, and fit before suggesting next steps.</p>
						<a href="/proposal" class="mt-7 inline-flex items-center gap-2 rounded-full bg-foreground px-6 py-3 text-sm font-semibold text-background transition-opacity hover:opacity-90">
							Request proposal
							@modules.UIIcon("arrow-right", "h-4 w-4")
						</a>
					</div>
					<div class="grid gap-3">
						@aboutContactLink("mail", "Email", "fernandocorreia316@gmail.com", "mailto:fernandocorreia316@gmail.com")
						@aboutContactLink("github", "GitHub", "github.com/FACorreiaa", "https://github.com/FACorreiaa")
						@aboutContactLink("linkedin", "LinkedIn", "Fernando Correia", "https://www.linkedin.com/in/fernando-correia-ab018079/")
					</div>
				</div>
			</section>
		</div>
	}
}

templ aboutInfoRow(iconName, label, value string) {
	<div class="flex items-start gap-3 rounded-md bg-muted/70 p-3">
		@modules.UIIcon(iconName, "mt-0.5 h-4 w-4 shrink-0 text-muted-foreground")
		<div class="min-w-0">
			<p class="text-xs font-medium text-muted-foreground">{ label }</p>
			<p class="mt-1 text-sm font-semibold leading-5">{ value }</p>
		</div>
	</div>
}

templ aboutContactLink(iconName, label, value, href string) {
	<a href={ templ.SafeURL(href) } target={ externalTarget(href) } rel={ externalRel(href) } class="group flex items-center justify-between gap-4 rounded-lg border border-border bg-card p-5 transition-colors hover:bg-accent/45">
		<span class="flex min-w-0 items-center gap-3">
			<span class="grid h-10 w-10 shrink-0 place-items-center rounded-md bg-muted">
				@modules.UIIcon(iconName, "h-5 w-5 text-foreground")
			</span>
			<span class="min-w-0">
				<span class="block text-sm text-muted-foreground">{ label }</span>
				<span class="block truncate font-semibold">{ value }</span>
			</span>
		</span>
		@modules.UIIcon("arrow-right", "h-4 w-4 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-1 group-hover:text-foreground")
	</a>
}

func externalTarget(href string) string {
	if len(href) >= 4 && href[:4] == "http" {
		return "_blank"
	}
	return ""
}

func externalRel(href string) string {
	if len(href) >= 4 && href[:4] == "http" {
		return "noopener noreferrer"
	}
	return ""
}
