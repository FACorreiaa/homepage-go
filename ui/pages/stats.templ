package pages

import (
	"fmt"

	"myapp/assets"

	"myapp/internal/service"
	"myapp/ui/layouts"
)

templ Stats(stats service.StatsSnapshot) {
	@layouts.BaseLayout(layouts.LayoutProps{
		Title:       "Live traffic | FC Software Studio",
		ActivePage:  "stats",
		Description: "A live map of who is reading facorreia.com right now, plotted at city resolution from this server's own traffic.",
	}) {
		<div class="public-shell min-h-screen">
			<section class="mx-auto max-w-6xl px-4 pt-24 md:pt-32">
				<p class="font-mono text-xs tracking-[0.18em] text-muted-foreground">SITE TELEMETRY — LIVE</p>
				<h1 class="hero-title mt-6 max-w-4xl font-semibold">Who's here right now.</h1>
				<p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground md:text-xl">
					Every dot is a real visit to this site in the last 24 hours, placed at city resolution.
					No IP addresses are stored, no cookies are set, and nothing here goes to anyone else.
				</p>
			</section>
			<section class="mx-auto max-w-6xl px-4 pt-14">
				<div class="globe-stage" id="globe-stage" data-globe>
					<p
						id="globe-status"
						class="absolute inset-0 grid place-items-center px-6 text-center font-mono text-xs text-muted-foreground"
					>
						loading map…
					</p>
				</div>
				<ul class="globe-legend">
					<li>drag to rotate · scroll to zoom</li>
					<li>
						<span class="globe-legend-swatch" style="background: var(--signal)"></span>
						here now
					</li>
					<li>
						<span class="globe-legend-swatch" style="background: var(--trail)"></span>
						last 24 hours
					</li>
					<li>the dark half of the map is the real night side</li>
				</ul>
			</section>
			@statsOpsStrip(stats)
			<section class="mx-auto max-w-6xl px-4 pt-16 pb-24 md:pb-32">
				<div class="grid gap-6 md:grid-cols-2">
					<div class="stat-panel" data-reveal>
						<h2 class="stat-panel-title">WHERE FROM — LAST 24H</h2>
						if len(stats.TopCountries) == 0 {
							<p class="stat-panel-empty">Nobody yet today. You're the first.</p>
						} else {
							<ul class="stat-list">
								for _, country := range stats.TopCountries {
									<li class="stat-row">
										@statRowBar(sharePct(country.Visits, maxCountryVisits(stats.TopCountries)))
										<span class="stat-row-label">
											<span aria-hidden="true">{ country.Flag }</span>
											<span class="font-mono text-sm">{ country.Code }</span>
										</span>
										<span class="stat-row-value">{ fmt.Sprintf("%d", country.Visits) }</span>
									</li>
								}
							</ul>
						}
					</div>
					<div class="stat-panel" data-reveal>
						<h2 class="stat-panel-title">WHAT THEY READ — LAST 24H</h2>
						if len(stats.TopPaths) == 0 {
							<p class="stat-panel-empty">No page views recorded in the window.</p>
						} else {
							<ul class="stat-list">
								for _, path := range stats.TopPaths {
									<li class="stat-row">
										@statRowBar(sharePct(path.Visits, maxPathVisits(stats.TopPaths)))
										<a href={ templ.SafeURL(path.Path) } class="stat-row-label truncate font-mono text-sm underline underline-offset-4 transition-colors hover:text-muted-foreground">{ path.Path }</a>
										<span class="stat-row-value">{ fmt.Sprintf("%d", path.Visits) }</span>
									</li>
								}
							</ul>
						}
					</div>
				</div>
				<p class="mt-14 max-w-2xl text-sm leading-6 text-muted-foreground">
					How this works: the server salts and hashes each visitor's address, looks the network up
					to a city, rounds the coordinates to a ~55km cell, and throws the address away. Rows are
					deleted after 24 hours. Rotating the salt unlinks everything stored before it.
				</p>
			</section>
		</div>
		@templ.Raw(`<script type="importmap">{"imports":{"three":"/assets/static/vendor/three/three.module.min.js","three/webgpu":"/assets/static/vendor/three/webgpu-stub.js","three/examples/jsm/":"/assets/static/vendor/three/addons/"}}</script>`)
		<script type="module" src={ assets.URL("static/globe.js") }></script>
	}
}

// statsOpsStrip mirrors the landing page's strip. It owns its own container
// because .ops-strip is the one element on the site that breaks the page
// gutter — nesting it inside a max-w section double-pads it and misaligns it.
templ statsOpsStrip(stats service.StatsSnapshot) {
	<section class="ops-strip mt-14" aria-label="Live site telemetry" data-reveal>
		<div class="mx-auto grid max-w-6xl grid-cols-2 gap-x-8 px-4 md:grid-cols-4">
			<div class="ops-metric">
				<span class="ops-metric-label">VISITORS NOW</span>
				<span class="ops-metric-value" data-live="true" data-metric="visitorsNow">{ fmt.Sprintf("%d", stats.VisitorsNow) }</span>
			</div>
			<div class="ops-metric">
				<span class="ops-metric-label">VIEWS 24H</span>
				<span class="ops-metric-value" data-metric="views24h">{ fmt.Sprintf("%d", stats.Views24h) }</span>
			</div>
			<div class="ops-metric">
				<span class="ops-metric-label">VISITORS 24H</span>
				<span class="ops-metric-value" data-metric="visitors24h">{ fmt.Sprintf("%d", stats.Visitors24h) }</span>
			</div>
			<div class="ops-metric">
				<span class="ops-metric-label">COUNTRIES 24H</span>
				<span class="ops-metric-value" data-metric="countries24h">{ fmt.Sprintf("%d", stats.Countries24h) }</span>
			</div>
		</div>
	</section>
}

// statRowBar is raw markup because templ sanitises dynamic style attributes.
// pct is produced by sharePct, which only ever emits an integer 0-100.
func statRowBar(pct int) templ.Component {
	return templ.Raw(fmt.Sprintf(`<span class="stat-row-bar" style="width:%d%%" aria-hidden="true"></span>`, pct))
}

// sharePct sizes a row's bar against the biggest row in its own list, so a
// quiet day still reads as a chart rather than four near-empty slivers.
func sharePct(visits, highest int) int {
	if highest <= 0 || visits <= 0 {
		return 0
	}
	pct := visits * 100 / highest
	if pct > 100 {
		return 100
	}
	return pct
}

func maxCountryVisits(rows []service.CountryCount) int {
	highest := 0
	for _, r := range rows {
		highest = max(highest, r.Visits)
	}
	return highest
}

func maxPathVisits(rows []service.PathCount) int {
	highest := 0
	for _, r := range rows {
		highest = max(highest, r.Visits)
	}
	return highest
}
