package pages

import (
	"fmt"
	"myapp/internal/service"
	"myapp/ui/layouts"
	"net/url"
	"strconv"
)

type BookmarkQuery struct {
	Q        string
	Category string
	Sort     string
	Page     int
	Total    int
	PerPage  int
}

func (p BookmarkQuery) Remaining() int {
	r := p.Total - p.Page*p.PerPage
	if r < 0 {
		return 0
	}
	return r
}

func (p BookmarkQuery) NextPageURL() string {
	v := url.Values{}
	v.Set("page", strconv.Itoa(p.Page+1))
	if p.Q != "" {
		v.Set("q", p.Q)
	}
	if p.Category != "" {
		v.Set("category", p.Category)
	}
	if p.Sort != "" {
		v.Set("sort", p.Sort)
	}
	return "/bookmarks?" + v.Encode()
}

// catHue maps a category name to a stable hue (0-359) shared by the
// library dots and the graph nodes.
func catHue(name string) int {
	h := 0
	for _, c := range name {
		h = (h*31 + int(c)) % 360
	}
	if h < 0 {
		h += 360
	}
	return h
}

func catDotStyle(name string) string {
	return fmt.Sprintf("background: hsl(%d 55%% 52%%)", catHue(name))
}

templ Bookmarks(idx service.BookmarkIndex, items []service.VaultFile, params BookmarkQuery) {
	@layouts.BaseLayout(layouts.LayoutProps{Title: "Bookmarks | FC Software Studio", ActivePage: "bookmarks", Description: "A digital garden and knowledge graph of my Obsidian notes, insights, and bookmarks."}) {
		<style>[x-cloak]{display:none!important}</style>
		<div class="public-shell min-h-screen" x-data="{ view: location.hash === '#graph' ? 'graph' : 'library' }" x-init="if (view === 'graph') window.loadGraph?.()">
			<section class="mx-auto max-w-5xl px-4 pt-20 md:pt-28">
				<h1 class="hero-title font-semibold">The archive.</h1>
				<p class="mt-5 max-w-2xl text-lg leading-8 text-muted-foreground">Notes, links, and research fragments clipped into an Obsidian vault and indexed here as they sync.</p>
				<p class="mt-6 font-mono text-xs tracking-wide text-muted-foreground">
					{ strconv.Itoa(len(idx.Files)) } notes
					<span class="mx-1.5 opacity-50">·</span>
					{ strconv.Itoa(len(idx.CategoryCounts())) } categories
					if idx.CrossLinkCount() > 0 {
						<span class="mx-1.5 opacity-50">·</span>
						{ strconv.Itoa(idx.CrossLinkCount()) } cross-links
					}
					<span class="mx-1.5 opacity-50">·</span>
					indexed { idx.BuiltAt.Format("Jan 2 15:04") }
				</p>
				<div class="mt-10 inline-flex rounded-full border border-border p-1 font-mono text-xs">
					<button
						@click="view = 'library'"
						:class="view === 'library' ? 'bg-foreground text-background' : 'text-muted-foreground hover:text-foreground'"
						class="rounded-full px-4 py-1.5 transition-colors"
					>Library</button>
					<button
						@click="view = 'graph'; history.replaceState(null, '', '#graph'); window.loadGraph?.()"
						:class="view === 'graph' ? 'bg-foreground text-background' : 'text-muted-foreground hover:text-foreground'"
						class="rounded-full px-4 py-1.5 transition-colors"
					>Graph</button>
				</div>
			</section>
			<section x-show="view === 'library'" class="mx-auto max-w-5xl px-4 pb-32 pt-10 md:pb-44">
				<form id="library-filters" action="/bookmarks" method="get" class="border-b border-border pb-6">
					<div class="flex flex-wrap items-center gap-3">
						<input
							type="search"
							name="q"
							value={ params.Q }
							placeholder="Search titles and excerpts…"
							autocomplete="off"
							hx-get="/bookmarks"
							hx-trigger="input changed delay:300ms, search"
							hx-target="#library-results"
							hx-swap="innerHTML"
							hx-include="closest form"
							hx-push-url="true"
							class="h-10 w-full max-w-sm rounded-md border border-border bg-card px-3 text-sm outline-none transition-colors focus:border-foreground/40"
						/>
						<select
							name="sort"
							aria-label="Sort notes"
							hx-get="/bookmarks"
							hx-trigger="change"
							hx-target="#library-results"
							hx-swap="innerHTML"
							hx-include="closest form"
							hx-push-url="true"
							class="h-10 rounded-md border border-border bg-card px-2 font-mono text-xs text-muted-foreground outline-none"
						>
							<option value="" selected?={ params.Sort == "" }>newest first</option>
							<option value="name" selected?={ params.Sort == "name" }>a → z</option>
							<option value="category" selected?={ params.Sort == "category" }>by category</option>
						</select>
					</div>
					<div class="mt-4 flex flex-wrap gap-2">
						<label class="cursor-pointer">
							<input
								type="radio"
								name="category"
								value=""
								checked?={ params.Category == "" }
								hx-get="/bookmarks"
								hx-trigger="change"
								hx-target="#library-results"
								hx-swap="innerHTML"
								hx-include="closest form"
								hx-push-url="true"
								class="peer sr-only"
							/>
							<span class="inline-flex items-center rounded-full border border-border px-3 py-1 font-mono text-xs text-muted-foreground transition-colors hover:text-foreground peer-checked:border-foreground peer-checked:text-foreground">all</span>
						</label>
						for _, cat := range idx.CategoryCounts() {
							<label class="cursor-pointer">
								<input
									type="radio"
									name="category"
									value={ cat.Name }
									checked?={ params.Category == cat.Name }
									hx-get="/bookmarks"
									hx-trigger="change"
									hx-target="#library-results"
									hx-swap="innerHTML"
									hx-include="closest form"
									hx-push-url="true"
									class="peer sr-only"
								/>
								<span class="inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1 font-mono text-xs text-muted-foreground transition-colors hover:text-foreground peer-checked:border-foreground peer-checked:text-foreground">
									<span class="h-1.5 w-1.5 rounded-full" style={ catDotStyle(cat.Name) }></span>
									{ cat.Name }
									<span class="opacity-50">{ strconv.Itoa(cat.Count) }</span>
								</span>
							</label>
						}
					</div>
				</form>
				<div id="library-results">
					@BookmarkResults(items, params)
				</div>
			</section>
			<section x-show="view === 'graph'" x-cloak class="mx-auto max-w-7xl px-4 pb-32 pt-10 md:pb-44">
				<p class="mb-4 font-mono text-xs text-muted-foreground">drag to rotate · scroll to zoom · click a sphere to read · <span style="color:#ff5533">hot</span> = recently touched, <span style="color:#7a6cff">cold</span> = older</p>
				<div class="relative">
					<div id="graph" class="w-full overflow-hidden rounded-lg border border-border" style="height:72vh;min-height:480px;background:#050208"></div>
					<p id="graph-loading" class="absolute inset-0 grid place-items-center font-mono text-xs text-muted-foreground" style="color:#8a86a8">initializing neural map…</p>
				</div>
			</section>
		</div>
		@templ.Raw(`<script type="importmap">{"imports":{"three":"/assets/static/vendor/three/three.module.min.js","three/webgpu":"/assets/static/vendor/three/webgpu-stub.js","three/examples/jsm/":"/assets/static/vendor/three/addons/"}}</script>`)
		<script type="module">
			let graphStarted = false;
			window.loadGraph = async function () {
				if (graphStarted) return;
				graphStarted = true;
				const [{ default: ForceGraph3D }, THREE, { UnrealBloomPass }, dataRes] = await Promise.all([
					import('/assets/static/vendor/3d-force-graph/3d-force-graph.bundle.mjs'),
					import('three'),
					import('/assets/static/vendor/three/addons/postprocessing/UnrealBloomPass.js'),
					fetch('/api/graph'),
				]);
				const data = await dataRes.json();
				const el = document.getElementById('graph');
				document.getElementById('graph-loading')?.remove();

				// Shared resources: one geometry, a small palette of emissive
				// materials bucketed by heat — keeps GPU state changes low.
				const sphereGeo = new THREE.SphereGeometry(1, 12, 10);
				const BUCKETS = 14;
				const heatMaterials = Array.from({ length: BUCKETS }, (_, i) => {
					const h = i / (BUCKETS - 1); // 0 cold → 1 hot
					const hue = (258 - 244 * h) / 360; // 258° blue-violet → 14° red-orange
					const c = new THREE.Color().setHSL(hue, 0.9, 0.34 + 0.16 * h);
					return new THREE.MeshLambertMaterial({ color: c, emissive: c, emissiveIntensity: 0.25 + 0.55 * h });
				});
				const hubColor = new THREE.Color().setHSL(0.09, 0.9, 0.62);
				const hubMaterial = new THREE.MeshLambertMaterial({ color: hubColor, emissive: hubColor, emissiveIntensity: 0.9 });

				const pulsing = [];
				const Graph = new ForceGraph3D(el, { rendererConfig: { antialias: true, powerPreference: 'high-performance' } })
					.width(el.clientWidth)
					.height(el.clientHeight)
					.backgroundColor('#050208')
					.cooldownTicks(0)
					.warmupTicks(0)
					.enableNodeDrag(false)
					.nodeThreeObject(node => {
						const mat = node.isHub ? hubMaterial : heatMaterials[Math.min(BUCKETS - 1, Math.floor(node.heat * BUCKETS))];
						const mesh = new THREE.Mesh(sphereGeo, mat);
						const r = 3.1 * Math.cbrt(node.val || 1);
						mesh.scale.setScalar(r);
						if (!node.isHub && node.heat > 0.9 && pulsing.length < 150) pulsing.push({ mesh, r, phase: Math.random() * Math.PI * 2 });
						return mesh;
					})
					.linkColor(() => '#5c5a7a')
					.linkOpacity(0.03)
					.nodeLabel(node => `<div style="font-family:ui-monospace,monospace;font-size:11px;background:#0b0618;color:#e8e4ff;border:1px solid #4c3d78;border-radius:6px;padding:6px 9px">
						<div style="color:#9d8cff">${node.category}${node.isHub ? ' · cluster' : ''}</div>
						<div style="margin-top:2px;font-weight:600">${node.name}</div>
					</div>`)
					.onNodeClick(node => {
						if (node.isHub) {
							window.location.href = '/bookmarks?category=' + encodeURIComponent(node.category);
						} else {
							window.location.href = '/bookmarks/' + node.id;
						}
					})
					.graphData(data);

				Graph.renderer().setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
				Graph.scene().add(new THREE.AmbientLight(0xffffff, 1.6));
				Graph.cameraPosition({ x: 0, y: 0, z: 3400 });

				const controls = Graph.controls();
				controls.autoRotate = true;
				controls.autoRotateSpeed = 0.4;
				el.addEventListener('pointerdown', () => { controls.autoRotate = false; }, { once: true });

				const bloom = new UnrealBloomPass(new THREE.Vector2(el.clientWidth, el.clientHeight), 0.85, 0.6, 0.1);
				Graph.postProcessingComposer().addPass(bloom);

				// Recently-touched nodes breathe.
				(function pulse(t) {
					for (const p of pulsing) {
						p.mesh.scale.setScalar(p.r * (1 + 0.14 * Math.sin(t / 420 + p.phase)));
					}
					requestAnimationFrame(pulse);
				})(0);

				window.addEventListener('resize', () => {
					Graph.width(el.clientWidth).height(el.clientHeight);
				}, { passive: true });
			};
		</script>
	}
}

templ BookmarkResults(items []service.VaultFile, params BookmarkQuery) {
	<p class="py-4 font-mono text-xs text-muted-foreground" role="status">
		if params.Q != "" || params.Category != "" {
			{ strconv.Itoa(params.Total) } matching notes
		} else {
			{ strconv.Itoa(params.Total) } notes
		}
	</p>
	<div class="divide-y divide-border border-t border-border">
		@BookmarkRows(items, params)
	</div>
	if len(items) == 0 {
		<div class="py-16 text-center">
			<p class="text-muted-foreground">No notes match this search.</p>
			<a href="/bookmarks" class="mt-3 inline-block font-mono text-xs text-foreground underline underline-offset-4">clear filters</a>
		</div>
	}
}

templ BookmarkRows(items []service.VaultFile, params BookmarkQuery) {
	for _, f := range items {
		<a href={ templ.SafeURL("/bookmarks/" + f.Slug) } class="group grid gap-1 py-5 transition-colors hover:bg-accent/40 sm:grid-cols-[7rem_1fr] sm:gap-6 sm:px-3">
			<time class="pt-0.5 font-mono text-xs text-muted-foreground">{ f.Date.Format("2006-01-02") }</time>
			<div class="min-w-0">
				<p class="truncate text-base font-medium leading-snug group-hover:underline group-hover:underline-offset-4">{ f.Name }</p>
				if f.Excerpt != "" {
					<p class="mt-1 line-clamp-2 text-sm leading-6 text-muted-foreground">{ f.Excerpt }</p>
				}
				<p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] text-muted-foreground">
					<span class="inline-flex items-center gap-1.5">
						<span class="h-1.5 w-1.5 rounded-full" style={ catDotStyle(f.Category) }></span>
						{ f.Category }
					</span>
					if f.SourceDomain() != "" {
						<span class="opacity-50">·</span>
						<span>{ f.SourceDomain() }</span>
					}
					<span class="opacity-50">·</span>
					<span>{ strconv.Itoa(f.ReadMinutes()) } min</span>
				</p>
			</div>
		</a>
	}
	if params.Remaining() > 0 {
		<button
			hx-get={ params.NextPageURL() }
			hx-target="this"
			hx-swap="outerHTML"
			class="block w-full py-5 text-center font-mono text-xs text-muted-foreground transition-colors hover:bg-accent/40 hover:text-foreground"
		>load { strconv.Itoa(minInt(params.PerPage, params.Remaining())) } more ↓ <span class="opacity-60">({ strconv.Itoa(params.Remaining()) } remaining)</span></button>
	}
}

func minInt(a, b int) int {
	if a < b {
		return a
	}
	return b
}
