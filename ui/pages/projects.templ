package pages

import (
	"fmt"

	"myapp/internal/model"
	"myapp/ui/layouts"
	"myapp/ui/modules"
)

templ Projects(trust []model.TrustItem, projects []model.ProjectItem) {
	@layouts.BaseLayout(layouts.LayoutProps{Title: "FC Software Studio | Product Engineering", ActivePage: "projects", Description: "Selected product work by Fernando Correia: Go backends, SwiftUI iOS apps, client delivery, and production infrastructure."}) {
		<div class="public-shell min-h-screen">
			<section class="mx-auto max-w-6xl px-4 pt-24 md:pt-32">
				<div class="grid gap-10 lg:grid-cols-[0.72fr_0.28fr] lg:items-end">
					<div>
						<p class="font-mono text-xs tracking-[0.18em] text-muted-foreground">FC SOFTWARE STUDIO / PRODUCT ENGINEERING</p>
						<h1 class="hero-title mt-6 max-w-5xl font-semibold">
							I build product systems that feel fast, calm, and finished.
						</h1>
						<p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground md:text-xl">
							Independent engineering practice for web apps, native iOS products, backend platforms, and the product glue between them.
						</p>
						<div class="mt-10 flex flex-wrap gap-3">
							<a href="/proposal" class="inline-flex items-center gap-2 rounded-full bg-foreground px-6 py-3 text-sm font-semibold text-background transition hover:opacity-90 active:scale-[0.97]">
								Request proposal
								@modules.UIIcon("arrow-right", "h-4 w-4")
							</a>
							<a href="#case-studies" class="rounded-full border border-border px-6 py-3 text-sm font-semibold text-foreground transition hover:bg-accent active:scale-[0.97]">View case studies</a>
						</div>
						<p class="mt-6 font-mono text-xs text-muted-foreground">
							Also open to senior product-engineering roles —
							<a href="/curriculum" class="underline underline-offset-4 transition-colors hover:text-foreground">view CV</a>
						</p>
					</div>
					<div class="divide-y divide-border rounded-2xl border border-border bg-card/72 backdrop-blur">
						for _, item := range trust {
							<div class="flex items-center justify-between gap-5 px-5 py-4">
								<span class="font-mono text-xs text-muted-foreground">{ item.Label }</span>
								<span class="text-2xl font-semibold tabular-nums">{ item.Value }</span>
							</div>
						}
					</div>
				</div>
			</section>

			<section id="case-studies" class="px-4 pt-24 md:pt-36">
				@modules.FeaturedProjectsSection(
					modules.FeaturedOf(projects),
					"Featured projects",
					"Hosted products and systems I shipped and still stand behind.",
					false,
				)
			</section>

			<section class="mx-auto max-w-6xl px-4 pb-32 pt-24 md:pb-44 md:pt-32">
				{{ rest := modules.RestOf(projects) }}
				<div class="mx-auto max-w-3xl text-center md:mx-0 md:max-w-3xl md:text-left">
					<p class="font-mono text-xs tracking-[0.18em] text-muted-foreground">INDEX — { fmt.Sprintf("%02d", len(rest)) } MORE</p>
					<h2 class="section-title mt-4 font-semibold">Additional work</h2>
					<p class="mt-5 max-w-2xl text-base leading-7 text-muted-foreground md:mx-0 mx-auto">A compact record of client systems, mobile products, and private infrastructure work.</p>
				</div>
				<div class="mt-10 grid gap-5 md:grid-cols-2 md:gap-6">
					for i, p := range rest {
						@modules.ProjectIndexCard(p, i)
					}
				</div>
			</section>
		</div>
	}
}
