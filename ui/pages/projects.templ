package pages

import (
	"myapp/internal/model"
	"myapp/ui/layouts"
	"strings"
)

templ Projects(trust []model.TrustItem, projects []model.ProjectItem) {
	@layouts.BaseLayout(layouts.LayoutProps{Title: "FC Software Studio | Product Engineering", ActivePage: "projects", Description: "Fernando Correia builds polished web apps, high-performance iOS apps, and production backends for product teams."}) {
		<div class="public-shell min-h-screen">
			<section class="mx-auto max-w-6xl px-4 pt-24 md:pt-36">
				<p class="font-mono text-xs tracking-widest text-muted-foreground">FC SOFTWARE STUDIO · PRODUCT ENGINEERING</p>
				<h1 class="hero-title mt-6 max-w-4xl font-semibold">
					I build product systems that feel fast, calm, and finished.
				</h1>
				<div class="mt-10 grid gap-10 md:grid-cols-[1.2fr_0.8fr] md:items-end">
					<p class="max-w-2xl text-lg leading-8 text-muted-foreground md:text-xl">
						Independent engineering practice for web applications, native iOS products, backend platforms, and the product glue between them.
					</p>
					<div class="flex flex-wrap gap-3 md:justify-end">
						<a href="/book-call" class="rounded-full bg-foreground px-7 py-3 text-sm font-semibold text-background transition-opacity hover:opacity-90">Book a Call</a>
						<a href="/proposal" class="rounded-full border border-border px-7 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-accent">Request Proposal</a>
					</div>
				</div>
				<p class="mt-14 border-t border-border pt-5 font-mono text-xs text-muted-foreground">
					for i, item := range trust {
						if i > 0 {
							<span class="mx-3 opacity-40">·</span>
						}
						<span class="font-semibold text-foreground">{ item.Value }</span>
						<span class="ml-1.5">{ strings.ToLower(item.Label) }</span>
					}
				</p>
			</section>
			<section class="mx-auto max-w-6xl px-4 pt-28 md:pt-40">
				<div class="flex items-baseline justify-between gap-6 border-b border-border pb-6">
					<h2 class="section-title font-semibold">Case studies</h2>
					<p class="font-mono text-xs text-muted-foreground">independent products, built end to end</p>
				</div>
				<div>
					for i, p := range featuredOf(projects) {
						<a href={ templ.SafeURL("/projects/" + p.Slug) } class="group grid gap-8 border-b border-border py-14 md:grid-cols-[0.9fr_1.1fr] md:gap-14 md:py-20" data-reveal>
							<div class={ "overflow-hidden rounded-lg border border-border bg-muted " + orderClass(i) }>
								if p.LogoAsset != "" {
									<img src={ p.LogoAsset } alt={ p.Title + " app artwork" } width="640" height="640" loading={ lazyAfter(i) } fetchpriority={ priorityFor(i) } class="aspect-[4/3] h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"/>
								} else {
									<div class="grid aspect-[4/3] place-items-center">
										if p.IconURL != "" {
											<img src={ p.IconURL } alt="" width="96" height="96" loading="lazy" class="h-24 w-24 opacity-80"/>
										} else {
											<span class="font-mono text-6xl font-semibold text-muted-foreground">{ p.Icon }</span>
										}
									</div>
								}
							</div>
							<div class="flex flex-col justify-center">
								<p class="font-mono text-xs text-muted-foreground">
									{ p.Category }
									<span class="mx-2 opacity-40">·</span>
									{ p.RoleTag }
									<span class="mx-2 opacity-40">·</span>
									<span class="text-foreground">{ p.Status }</span>
								</p>
								<h3 class="mt-4 text-3xl font-semibold tracking-normal md:text-5xl">{ p.Title }</h3>
								<p class="mt-5 max-w-xl text-base leading-7 text-muted-foreground md:text-lg">{ p.Description }</p>
								<p class="mt-6 font-mono text-xs leading-6 text-muted-foreground">{ strings.Join(p.Tags, "  ·  ") }</p>
								<span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold">
									Open case study
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
								</span>
							</div>
						</a>
					}
				</div>
			</section>
			<section class="mx-auto max-w-6xl px-4 pb-32 pt-24 md:pb-44 md:pt-32">
				<div class="flex items-baseline justify-between gap-6 border-b border-border pb-6">
					<h2 class="section-title font-semibold">More work</h2>
					<p class="font-mono text-xs text-muted-foreground">client systems and internal infrastructure</p>
				</div>
				<div class="divide-y divide-border">
					for _, p := range restOf(projects) {
						<a href={ templ.SafeURL("/projects/" + p.Slug) } class="group grid gap-2 py-6 transition-colors hover:bg-accent/40 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-8 sm:px-3" data-reveal>
							<div class="min-w-0">
								<p class="text-lg font-medium group-hover:underline group-hover:underline-offset-4">{ p.Title }</p>
								<p class="mt-1 line-clamp-2 max-w-2xl text-sm leading-6 text-muted-foreground">{ p.Description }</p>
							</div>
							<p class="shrink-0 font-mono text-[11px] text-muted-foreground sm:text-right">
								{ p.Category }
								<span class="mx-2 opacity-40">·</span>
								{ p.Status }
							</p>
						</a>
					}
				</div>
			</section>
			<section class="border-t border-border px-4 py-28 md:py-36">
				<div class="mx-auto max-w-6xl">
					<h2 class="section-title max-w-3xl font-semibold" data-reveal>Have a product that needs senior engineering taste?</h2>
					<div class="mt-10 flex flex-wrap gap-3">
						<a href="/book-call" class="rounded-full bg-foreground px-7 py-3 text-sm font-semibold text-background transition-opacity hover:opacity-90">Book a Call</a>
						<a href="/proposal" class="rounded-full border border-border px-7 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-accent">Request Proposal</a>
					</div>
				</div>
			</section>
		</div>
	}
}

func featuredOf(projects []model.ProjectItem) []model.ProjectItem {
	var out []model.ProjectItem
	for _, p := range projects {
		if p.Featured {
			out = append(out, p)
		}
	}
	return out
}

func restOf(projects []model.ProjectItem) []model.ProjectItem {
	var out []model.ProjectItem
	for _, p := range projects {
		if !p.Featured {
			out = append(out, p)
		}
	}
	return out
}

// orderClass alternates the image column side on desktop.
func orderClass(i int) string {
	if i%2 == 1 {
		return "md:order-2"
	}
	return ""
}

// The first case-study image is likely the LCP element — load it eagerly.
func lazyAfter(i int) string {
	if i == 0 {
		return "eager"
	}
	return "lazy"
}

func priorityFor(i int) string {
	if i == 0 {
		return "high"
	}
	return "auto"
}
