package layouts

import (
	"myapp/assets"
	"myapp/ui/modules"
)

type LayoutProps struct {
	Title       string
	Description string
	OGImage     string
	OGType      string
	ActivePage  string

	// ExtraJSONLD is one or more full <script type="application/ld+json">…</script>
	// blocks (page-specific BlogPosting, BreadcrumbList, etc.). Safe to leave empty.
	ExtraJSONLD string

	// SmoothScroll hands scrolling to Lenis on this page. Two things in the
	// layout fight it and have to stand down when it is set: the native
	// scroll-behavior on <html>, and the scroll-to-top button's window.scrollTo.
	SmoothScroll bool
}

func (p LayoutProps) htmlClass() string {
	if p.SmoothScroll {
		return ""
	}
	return "scroll-smooth"
}

func (p LayoutProps) title() string {
	if p.Title == "" {
		return "FC Software Studio"
	}
	return p.Title
}

func (p LayoutProps) description() string {
	if p.Description == "" {
		return "FC Software Studio - Fernando Correia. Go backends, SwiftUI iOS apps, and Kubernetes production systems for product teams."
	}
	return p.Description
}

func (p LayoutProps) ogImage() string {
	if p.OGImage == "" {
		return "https://facorreia.com/assets/static/icon-512.png"
	}
	return p.OGImage
}

func (p LayoutProps) ogType() string {
	if p.OGType == "" {
		return "website"
	}
	return p.OGType
}

templ BaseLayout(props LayoutProps) {
	<!DOCTYPE html>
	<html lang="en" class={ props.htmlClass() }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.title() }</title>
			<meta name="description" content={ props.description() }/>
			<meta name="author" content="Fernando Correia"/>
			<meta name="robots" content="index,follow,max-image-preview:large"/>
			<meta name="googlebot" content="index,follow"/>
			<link rel="canonical" href={ canonicalURL(ctx) }/>
			<meta property="og:site_name" content="FC Software Studio"/>
			<meta property="og:locale" content="en_US"/>
			<meta property="og:url" content={ canonicalURL(ctx) }/>
			<meta property="og:title" content={ props.title() }/>
			<meta property="og:description" content={ props.description() }/>
			<meta property="og:type" content={ props.ogType() }/>
			<meta property="og:image" content={ props.ogImage() }/>
			<meta property="og:image:alt" content={ props.title() }/>
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:title" content={ props.title() }/>
			<meta name="twitter:description" content={ props.description() }/>
			<meta name="twitter:image" content={ props.ogImage() }/>
			<meta name="theme-color" content="#0f172a"/>
			// Person + WebSite JSON-LD for brand/person entity.
			@templ.Raw(`<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://facorreia.com/#website","url":"https://facorreia.com/","name":"FC Software Studio","description":"Portugal-based product engineering studio. Go backends, SwiftUI iOS apps, Kubernetes production systems.","inLanguage":"en","publisher":{"@id":"https://facorreia.com/#person"}},{"@type":"Person","@id":"https://facorreia.com/#person","name":"Fernando Correia","url":"https://facorreia.com/","jobTitle":"Software Engineer","address":{"@type":"PostalAddress","addressLocality":"Porto","addressCountry":"PT"},"sameAs":["https://github.com/FACorreiaa"],"knowsAbout":["Go","Swift","SwiftUI","Kubernetes","product engineering","backend systems"]},{"@type":"ProfessionalService","@id":"https://facorreia.com/#studio","name":"FC Software Studio","url":"https://facorreia.com/","image":"https://facorreia.com/assets/static/icon-512.png","areaServed":"Worldwide","availableLanguage":["en","pt"],"founder":{"@id":"https://facorreia.com/#person"}}]}</script>`)
			if props.ExtraJSONLD != "" {
				@templ.Raw(props.ExtraJSONLD)
			}
			<link rel="icon" type="image/png" sizes="192x192" href="/assets/static/icon-192.png"/>
			<link rel="apple-touch-icon" href="/assets/static/icon-192.png"/>
			<link rel="manifest" href="/assets/static/manifest.json"/>
			<link rel="preload" href="/assets/fonts/geist/geist-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			// Fingerprinted. A browser that cached this while it was being served
			// immutable will never revalidate the bare URL, so the only way to
			// reach it is a URL it has not seen before.
			<link href={ assets.URL("css/output.css") } rel="stylesheet"/>
			<script>
				(function() {
					document.documentElement.classList.add('js');
					const t = localStorage.getItem('theme');
					if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
						document.documentElement.classList.add('dark');
					}
				})();
				function toggleTheme() {
					const isDark = document.documentElement.classList.toggle('dark');
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				}
			</script>
		</head>
		<body class="bg-background text-foreground min-h-screen flex flex-col overflow-x-hidden w-full max-w-full">
			<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-foreground focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-background">
				Skip to content
			</a>
			<div id="top-sentinel" class="h-px" aria-hidden="true"></div>
			@modules.Navbar(props.ActivePage)
			<main id="main-content" class="flex-1 overflow-x-hidden w-full max-w-full">
				{ children... }
			</main>
			@modules.Footer()
			<button
				onclick="if(window.__lenis){window.__lenis.scrollTo(0)}else{window.scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'})}"
				id="scroll-top-btn"
				aria-label="Scroll to top"
				class="fixed bottom-6 right-6 z-50 p-2 rounded-full bg-primary text-primary-foreground shadow-lg opacity-0 pointer-events-none transition duration-200 ease-out active:scale-[0.97]"
			>
				@modules.UIIcon("arrow-up", "h-5 w-5")
			</button>
			<script>
				(function() {
					const btn = document.getElementById('scroll-top-btn');
					const sentinel = document.getElementById('top-sentinel');
					if (btn && sentinel && 'IntersectionObserver' in window) {
						const topObserver = new IntersectionObserver(function(entries) {
							const isAtTop = entries[0] && entries[0].isIntersecting;
							btn.classList.toggle('opacity-0', isAtTop);
							btn.classList.toggle('pointer-events-none', isAtTop);
						});
						topObserver.observe(sentinel);
					}
					const obs = new IntersectionObserver(function(entries) {
						entries.forEach(function(e) {
							if (e.isIntersecting) { e.target.classList.add('revealed'); obs.unobserve(e.target); }
						});
					}, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
					document.querySelectorAll('[data-reveal]').forEach(function(el) { obs.observe(el); });
				})();
				if ('serviceWorker' in navigator) {
					window.addEventListener('load', function() {
						navigator.serviceWorker.register('/assets/static/sw.js').catch(function(){});
					});
				}
			</script>
			<script defer src="/assets/static/vendor/alpine/alpine.min.js"></script>
			<script defer src="/assets/static/vendor/htmx/htmx.min.js"></script>
		</body>
	</html>
}
