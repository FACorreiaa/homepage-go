package modules

import (
	"net/url"
	"strings"

	"myapp/internal/model"
)

// FeaturedProjectsSection is the hosted-work gallery used on home and /projects.
// Every card has the same anatomy and sits in a uniform two-column grid: no
// flagship hero, so no project can outgrow its row and no logo can outgrow the
// text beside it. One project is capped so it does not stretch to full width.
templ FeaturedProjectsSection(projects []model.ProjectItem, title, subtitle string, showAllWorkCTA bool) {
	<div class="mx-auto max-w-6xl">
		<div class="flex flex-wrap items-end justify-between gap-6">
			<div class="max-w-3xl">
				if title != "" {
					<h2 class="section-title font-semibold tracking-tight text-balance">{ title }</h2>
				}
				if subtitle != "" {
					<p class="mt-5 max-w-2xl text-base leading-7 text-muted-foreground">{ subtitle }</p>
				}
			</div>
			if showAllWorkCTA {
				@allProjectsLink("hidden md:inline-flex")
			}
		</div>
		<div
			class={
				"mt-10 grid gap-6 md:gap-7",
				templ.KV("md:grid-cols-2", len(projects) > 1),
				templ.KV("max-w-3xl", len(projects) == 1),
			}
		>
			for i, p := range projects {
				@ProjectFeatureCard(p, i)
			}
		</div>
		if showAllWorkCTA {
			<div class="mt-8 flex md:hidden">
				@allProjectsLink("inline-flex")
			</div>
		}
	</div>
}

templ allProjectsLink(class string) {
	<a href="/projects" class={ class + " min-h-11 items-center gap-2 font-mono text-xs tracking-[0.08em] text-muted-foreground transition-colors hover:text-foreground" }>
		All projects
		@UIIcon("arrow-right", "h-3.5 w-3.5")
	</a>
}

// ProjectFeatureCard is one compact, information-first card: a small app mark
// inline with the title, tagline, and meta line; the description; up to three
// highlights; then a footer of stack chips and links. The mark, title, and CTA
// are three plain links to the case study and the external links are siblings,
// so nothing nests an anchor inside an anchor.
templ ProjectFeatureCard(p model.ProjectItem, i int) {
	{{ host := liveHost(p) }}
	{{ caseStudy := templ.SafeURL("/projects/" + p.Slug) }}
	<article
		class={ "project-feature-card project-showcase-card group flex flex-col overflow-hidden rounded-2xl border border-border bg-card " + projectToneClass(i) }
		data-reveal
	>
		<div class="flex-1 p-6 md:p-7">
			<header class="flex items-start gap-5">
				<a
					href={ caseStudy }
					class="project-app-mark h-16 w-16 shrink-0 md:h-[4.5rem] md:w-[4.5rem] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
					aria-label={ "View " + p.Title + " case study" }
					tabindex="-1"
				>
					if p.LogoAsset != "" {
						<img src={ p.LogoAsset } alt="" width="72" height="72" loading={ lazyAfter(i) } fetchpriority={ priorityFor(i) } class="h-full w-full object-cover"/>
					} else {
						<span class="font-mono text-lg font-semibold">{ p.Icon }</span>
					}
				</a>
				<div class="min-w-0 flex-1">
					<h3 class="text-xl font-semibold tracking-tight text-foreground md:text-2xl">
						<a href={ caseStudy } class="focus-visible:outline-none focus-visible:underline focus-visible:underline-offset-4">{ p.Title }</a>
					</h3>
					if p.Tagline != "" {
						<p class="mt-1 text-sm leading-6 text-muted-foreground md:text-base">{ p.Tagline }</p>
					}
					<p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] tracking-[0.08em]">
						<span class="text-muted-foreground">{ "[" + displayGroup(p) + "]" }</span>
						if p.Status != "" {
							<span class="project-status">{ p.Status }</span>
						}
						if p.RoleTag != "" {
							<span class="text-muted-foreground">{ p.RoleTag }</span>
						}
					</p>
				</div>
			</header>
			<p class="mt-5 line-clamp-3 text-sm leading-6 text-muted-foreground md:text-[0.95rem] md:leading-7">{ p.Description }</p>
			if len(p.Highlights) > 0 {
				<p class="mt-5 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">Highlights</p>
				<ul class="project-highlights mt-2 space-y-1.5 text-sm leading-6">
					for _, h := range topHighlights(p.Highlights, 3) {
						<li>{ h }</li>
					}
				</ul>
			}
		</div>
		<footer class="flex flex-wrap items-center justify-between gap-3 border-t border-border px-6 py-4 md:px-7">
			<div class="flex flex-wrap gap-2">
				for _, tag := range topTags(p.Tags, 3) {
					<span class="project-meta-chip">{ tag }</span>
				}
			</div>
			<div class="flex flex-wrap items-center gap-2">
				if p.HasLiveLink {
					<a href={ templ.SafeURL(p.LiveLink) } target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border px-3 py-1.5 text-xs font-semibold transition hover:bg-accent">
						Website
						if host != "" {
							<span class="font-mono font-medium text-muted-foreground">{ host }</span>
						}
						@UIIcon("external", "h-3.5 w-3.5")
					</a>
				}
				if p.AppStoreLink != "" {
					<a href={ templ.SafeURL(p.AppStoreLink) } target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border px-3 py-1.5 text-xs font-semibold transition hover:bg-accent">
						App Store
						@UIIcon("external", "h-3.5 w-3.5")
					</a>
				}
				<a href={ caseStudy } class="inline-flex min-h-11 items-center gap-2 rounded-full bg-foreground px-4 py-1.5 text-xs font-semibold text-background transition hover:opacity-90 active:scale-[0.97]">
					View case study
					@UIIcon("arrow-right", "h-3.5 w-3.5 motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover:translate-x-0.5")
				</a>
			</div>
		</footer>
	</article>
}

templ ProjectIndexCard(p model.ProjectItem, i int) {
	<a
		href={ templ.SafeURL("/projects/" + p.Slug) }
		class="project-index-card group flex min-h-56 flex-col overflow-hidden rounded-2xl border border-border bg-card transition-colors hover:border-foreground/20 hover:bg-accent/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
		data-reveal
	>
		if p.ScreenshotAsset != "" {
			<div class="relative aspect-[16/10] overflow-hidden border-b border-border bg-muted/30">
				<img
					src={ p.ScreenshotAsset }
					alt={ screenshotAlt(p) }
					loading="lazy"
					class="h-full w-full object-cover object-top motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.02]"
				/>
			</div>
		}
		<div class="flex flex-1 flex-col p-5">
			<div class="flex items-start justify-between gap-4">
				<div class="flex items-center gap-3">
					@projectMiniMark(p, i)
					<div>
						<p class="text-lg font-semibold tracking-tight">{ p.Title }</p>
						<p class="mt-1 text-xs font-medium text-muted-foreground">{ displayGroup(p) }</p>
					</div>
				</div>
				if p.Status != "" {
					<span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">{ p.Status }</span>
				}
			</div>
			<p class="mt-4 line-clamp-3 text-sm leading-6 text-muted-foreground">{ p.Description }</p>
			<div class="mt-auto flex items-end justify-between gap-4 pt-5">
				<div class="flex flex-wrap gap-2">
					for _, tag := range topTags(p.Tags, 2) {
						<span class="project-tag-pill">{ tag }</span>
					}
				</div>
				@UIIcon("arrow-right", "h-4 w-4 shrink-0 text-muted-foreground motion-safe:transition-transform motion-safe:group-hover:translate-x-1 group-hover:text-foreground")
			</div>
		</div>
	</a>
}

templ projectMiniMark(p model.ProjectItem, i int) {
	<div class={ "project-mini-mark " + projectToneClass(i) }>
		if p.LogoAsset != "" {
			<img src={ p.LogoAsset } alt="" width="44" height="44" loading="lazy" class="h-full w-full object-cover"/>
		} else {
			<span class="font-mono text-xs font-semibold">{ p.Icon }</span>
		}
	</div>
}

// ProjectVisual is the framed art stage used on case-study detail headers.
templ ProjectVisual(p model.ProjectItem, i int, class string) {
	<div class={ "project-art-shell texture-noise " + projectToneClass(i) + " " + class }>
		<div class="project-art-grid"></div>
		if p.ScreenshotAsset != "" {
			<div class="relative z-10 h-full w-full p-5 md:p-7">
				<img src={ p.ScreenshotAsset } alt={ screenshotAlt(p) } loading={ lazyAfter(i) } fetchpriority={ priorityFor(i) } class="h-full w-full rounded-md border border-foreground/12 object-cover shadow-lg object-top"/>
			</div>
		} else {
			<div class="relative z-10 flex flex-col items-center text-center">
				<div class="project-app-mark h-28 w-28 md:h-32 md:w-32">
					if p.LogoAsset != "" {
						<img src={ p.LogoAsset } alt={ p.Title + " app mark" } width="160" height="160" loading={ lazyAfter(i) } fetchpriority={ priorityFor(i) } class="h-full w-full object-cover"/>
					} else {
						<span class="font-mono text-3xl font-semibold">{ p.Icon }</span>
					}
				</div>
				<p class="mt-5 max-w-[18rem] text-sm font-medium text-foreground/78">{ p.Category }</p>
			</div>
		}
	</div>
}

func FeaturedOf(projects []model.ProjectItem) []model.ProjectItem {
	var out []model.ProjectItem
	for _, p := range projects {
		if p.Featured {
			out = append(out, p)
		}
	}
	return out
}

func RestOf(projects []model.ProjectItem) []model.ProjectItem {
	var out []model.ProjectItem
	for _, p := range projects {
		if !p.Featured {
			out = append(out, p)
		}
	}
	return out
}

func liveHost(p model.ProjectItem) string {
	if !p.HasLiveLink || p.LiveLink == "" {
		return ""
	}
	u, err := url.Parse(p.LiveLink)
	if err != nil || u.Host == "" {
		return ""
	}
	return strings.TrimPrefix(u.Host, "www.")
}

func topTags(tags []string, limit int) []string {
	if len(tags) <= limit {
		return tags
	}
	return tags[:limit]
}

func topHighlights(items []string, limit int) []string {
	if len(items) <= limit {
		return items
	}
	return items[:limit]
}

func displayGroup(p model.ProjectItem) string {
	if p.DisplayGroup != "" {
		return p.DisplayGroup
	}
	return p.Category
}

func screenshotAlt(p model.ProjectItem) string {
	if p.ScreenshotAlt != "" {
		return p.ScreenshotAlt
	}
	return p.Title + " product screenshot"
}

func projectToneClass(i int) string {
	switch i % 5 {
	case 0:
		return "project-tone-slate"
	case 1:
		return "project-tone-emerald"
	case 2:
		return "project-tone-ink"
	case 3:
		return "project-tone-rust"
	default:
		return "project-tone-steel"
	}
}

func lazyAfter(i int) string {
	if i == 0 {
		return "eager"
	}
	return "lazy"
}

func priorityFor(i int) string {
	if i == 0 {
		return "high"
	}
	return "auto"
}
