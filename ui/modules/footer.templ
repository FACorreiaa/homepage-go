package modules

templ Footer() {
	<footer class="mt-auto border-t border-border bg-foreground text-background">
		<div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
			<div class="grid gap-12 md:grid-cols-[1.35fr_1fr_1fr_1fr] md:gap-10 lg:gap-16">
				<div class="max-w-sm">
					<a href="/" class="inline-flex items-center gap-3" aria-label="FACorreia home">
						<span class="footer-mark" aria-hidden="true"></span>
						<span class="text-xl font-semibold tracking-tight text-background">FACorreia</span>
					</a>
					<p class="mt-5 text-sm leading-6 text-background/65">
						Independent product engineering for polished web apps, high-performance iOS products, and the backends behind them.
					</p>
					<div class="mt-7 flex items-center gap-4">
						<a href="https://github.com/FACorreiaa" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-background/70 transition-colors duration-200 hover:text-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-background/40">
							@UIIcon("github", "h-5 w-5")
						</a>
						<a href="https://www.linkedin.com/in/fernando-correia-ab018079/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-background/70 transition-colors duration-200 hover:text-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-background/40">
							@UIIcon("linkedin", "h-5 w-5")
						</a>
						<a href="mailto:fernandocorreia316@gmail.com" aria-label="Email Fernando" class="text-background/70 transition-colors duration-200 hover:text-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-background/40">
							@UIIcon("mail", "h-5 w-5")
						</a>
					</div>
				</div>

				<div>
					<p class="mb-5 text-sm font-semibold text-background">Explore</p>
					<nav class="space-y-3" aria-label="Explore">
						for _, l := range [][]string{{"Projects", "/projects"}, {"About", "/about"}, {"Stack", "/stack"}, {"Blog", "/blog"}, {"Garden", "/bookmarks"}} {
							<a href={ templ.SafeURL(l[1]) } class="block text-sm text-background/60 transition-colors duration-200 hover:text-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-background/40">{ l[0] }</a>
						}
					</nav>
				</div>

				<div>
					<p class="mb-5 text-sm font-semibold text-background">Services</p>
					<nav class="space-y-3" aria-label="Services">
						for _, s := range [][]string{{"Web applications", "/proposal"}, {"iOS products", "/proposal"}, {"Backend platforms", "/proposal"}, {"Product systems", "/proposal"}} {
							<a href={ templ.SafeURL(s[1]) } class="block text-sm text-background/60 transition-colors duration-200 hover:text-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-background/40">{ s[0] }</a>
						}
					</nav>
				</div>

				<div>
					<p class="mb-5 text-sm font-semibold text-background">Company</p>
					<nav class="space-y-3" aria-label="Company">
						for _, l := range [][]string{{"Request proposal", "/proposal"}, {"Curriculum", "/curriculum"}, {"Contact", "mailto:fernandocorreia316@gmail.com"}, {"Live traffic", "/stats"}} {
							<a href={ templ.SafeURL(l[1]) } class="block text-sm text-background/60 transition-colors duration-200 hover:text-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-background/40">{ l[0] }</a>
						}
					</nav>
				</div>
			</div>

			<div class="mt-14 border-t border-background/10 pt-8">
				<p class="text-center text-sm text-background/50">© 2026 FACorreia. All rights reserved.</p>
				<p class="mt-3 text-center font-mono text-xs text-background/40">Built with Go, templ, HTMX, SQLite</p>
				// The Go Gopher is CC BY 4.0, which requires attribution — see
				// assets/static/models/LICENSE.md. The 3D model itself is CC0.
				<p class="mt-5 text-center font-mono text-xs leading-5 text-background/35">
					The Go Gopher on the landing page is by
					<a href="https://go.dev/blog/gopher" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 transition-colors hover:text-background/55">Renée French</a>,
					licensed
					<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 transition-colors hover:text-background/55">CC BY 4.0</a>.
				</p>
			</div>
		</div>
	</footer>
}
