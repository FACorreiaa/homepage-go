package modules

templ Footer() {
	<footer class="mt-auto border-t border-border bg-foreground text-background">
		<div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
			<!-- CTA -->
			<div class="grid gap-10 border-b border-background/12 pb-16 md:grid-cols-[1.5fr_0.5fr] md:items-end">
				<div>
					<p class="inline-flex items-center gap-2 font-mono text-xs text-background/70">
						<span class="relative flex h-2 w-2">
							<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
							<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
						</span>
						AVAILABLE FOR NEW PROJECTS
					</p>
					<p class="mt-5 max-w-4xl text-[clamp(2.25rem,5vw,4.5rem)] font-semibold leading-[0.98] tracking-tight">Have a product that needs senior engineering taste?</p>
				</div>
				<div class="flex flex-col gap-3 sm:flex-row md:flex-col">
					<a href="/book-call" class="rounded-full bg-background px-6 py-3 text-center text-sm font-semibold text-foreground transition-opacity hover:opacity-88">Book a Call</a>
					<a href="/proposal" class="rounded-full border border-background/25 px-6 py-3 text-center text-sm font-semibold text-background transition-colors hover:bg-background/10">Request Proposal</a>
				</div>
			</div>
			<!-- Columns -->
			<div class="grid gap-10 py-16 md:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
				<div>
					<a href="/" class="inline-flex items-center gap-3 font-semibold">
						<span class="grid h-9 w-9 place-items-center rounded-full bg-background text-sm text-foreground">FC</span>
						<span>Software Studio</span>
					</a>
					<p class="mt-5 max-w-xs text-sm leading-6 text-background/72">Independent product engineering — polished web apps, high-performance iOS apps, and the backends behind them.</p>
				</div>
				<div>
					<p class="mb-4 font-mono text-[11px] uppercase tracking-wider text-background/55">Explore</p>
					<nav class="space-y-2.5">
						for _, l := range [][]string{{"Projects", "/projects"}, {"About", "/about"}, {"CV", "/curriculum"}, {"Stack", "/stack"}, {"Blog", "/blog"}, {"Garden", "/bookmarks"}} {
							<a href={ templ.SafeURL(l[1]) } class="block text-sm text-background/72 transition-colors hover:text-background">{ l[0] }</a>
						}
					</nav>
				</div>
				<div>
					<p class="mb-4 font-mono text-[11px] uppercase tracking-wider text-background/55">Services</p>
					<nav class="space-y-2.5">
						for _, s := range []string{"Web applications", "iOS products", "Backend platforms", "Product systems"} {
							<a href="/proposal" class="block text-sm text-background/72 transition-colors hover:text-background">{ s }</a>
						}
					</nav>
				</div>
				<div>
					<p class="mb-4 font-mono text-[11px] uppercase tracking-wider text-background/55">Contact</p>
					<a href="mailto:fernandocorreia316@gmail.com" class="block text-sm text-background/72 transition-colors hover:text-background">fernandocorreia316@gmail.com</a>
					<p class="mt-2.5 text-sm text-background/72">Portugal · Remote</p>
					<div class="mt-5 flex gap-3">
						<a href="https://github.com/FACorreiaa" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="grid h-9 w-9 place-items-center rounded-full border border-background/15 text-background/72 transition-colors hover:border-background/40 hover:text-background">
							<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
						</a>
						<a href="https://www.linkedin.com/in/fernando-correia-ab018079/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="grid h-9 w-9 place-items-center rounded-full border border-background/15 text-background/72 transition-colors hover:border-background/40 hover:text-background">
							<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path></svg>
						</a>
					</div>
				</div>
			</div>
			<div class="flex flex-col items-center justify-between gap-4 border-t border-background/12 pt-8 md:flex-row">
				<p class="text-sm text-background/60">© 2026 FC Software Studio. All rights reserved.</p>
				<p class="font-mono text-xs text-background/60">Built with Go · Templ · HTMX · SQLite</p>
			</div>
		</div>
	</footer>
}
