package modules

templ Navbar(activePage string) {
	<nav class="sticky top-0 z-50 px-3 py-3">
		<div class="mx-auto flex max-w-7xl items-center justify-between rounded-full border border-border/70 bg-background/85 px-4 py-2 shadow-[0_18px_60px_rgba(0,0,0,0.08)] backdrop-blur-xl">
			<a href="/" class="flex items-center gap-3 font-semibold tracking-tight">
				<span class="grid h-9 w-9 place-items-center rounded-full bg-foreground text-sm text-background">FC</span>
				<span class="hidden text-sm text-muted-foreground sm:inline">Software Studio</span>
			</a>
			<div class="hidden items-center gap-1 lg:flex">
				@navLink("/projects", "Projects", activePage == "projects")
				@navLink("/about", "About", activePage == "about")
				@navLink("/curriculum", "CV", activePage == "curriculum")
				@navLink("/stack", "Stack", activePage == "stack")
				@navLink("/blog", "Blog", activePage == "blog")
				@navLink("/bookmarks", "Garden", activePage == "bookmarks")
				@navLink("/play", "Play", activePage == "play")
				@navLink("/stats", "Live", activePage == "stats")
				<div class="mx-2 h-5 w-px bg-border"></div>
				<a href="https://github.com/FACorreiaa" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="rounded-full p-2 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">
					@UIIcon("github", "h-4 w-4")
				</a>
				<button onclick="toggleTheme()" aria-label="Toggle theme" class="rounded-full p-2 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">
					@UIIcon("sun", "hidden h-4 w-4 dark:block")
					@UIIcon("moon", "block h-4 w-4 dark:hidden")
				</button>
				<a href="/proposal" class="ml-1 inline-flex items-center gap-2 rounded-full bg-foreground px-4 py-2 text-sm font-semibold text-background transition hover:opacity-90 active:scale-[0.97]">
					Request proposal
					@UIIcon("arrow-right", "h-4 w-4")
				</a>
			</div>
			<div class="flex items-center gap-2 lg:hidden" x-data="{ open: false }">
				<button onclick="toggleTheme()" aria-label="Toggle theme" class="rounded-full p-2 hover:bg-accent">
					@UIIcon("sun", "hidden h-4 w-4 dark:block")
					@UIIcon("moon", "block h-4 w-4 dark:hidden")
				</button>
				<button @click="open = !open" :aria-expanded="open.toString()" aria-label="Toggle menu" class="rounded-full p-2 hover:bg-accent">
					@UIIcon("menu", "h-5 w-5")
				</button>
				<div x-show="open" x-cloak @click.away="open = false" class="fixed inset-0 z-50 flex">
					<div
						x-show="open"
						x-transition:enter="motion-safe:transition-opacity motion-safe:duration-150 motion-safe:ease-out"
						x-transition:enter-start="opacity-0"
						x-transition:enter-end="opacity-100"
						x-transition:leave="motion-safe:transition-opacity motion-safe:duration-150 motion-safe:ease-out"
						x-transition:leave-start="opacity-100"
						x-transition:leave-end="opacity-0"
						class="fixed inset-0 bg-black/40"
						@click="open = false"
					></div>
					<nav
						x-show="open"
						x-transition:enter="motion-safe:transition-transform motion-safe:duration-[250ms] motion-safe:ease-[cubic-bezier(0.23,1,0.32,1)]"
						x-transition:enter-start="translate-x-full"
						x-transition:enter-end="translate-x-0"
						x-transition:leave="motion-safe:transition-transform motion-safe:duration-200 motion-safe:ease-[cubic-bezier(0.23,1,0.32,1)]"
						x-transition:leave-start="translate-x-0"
						x-transition:leave-end="translate-x-full"
						role="dialog"
						aria-modal="true"
						aria-label="Mobile navigation"
						class="relative ml-auto flex h-full w-72 flex-col gap-2 overflow-y-auto bg-background p-6 shadow-xl"
					>
						<div class="mb-4 flex items-center justify-between">
							<a href="/" class="flex items-center gap-2 font-semibold" @click="open=false">
								<span class="grid h-8 w-8 place-items-center rounded-full bg-foreground text-xs text-background">FC</span>
								<span>Studio</span>
							</a>
							<button @click="open=false" aria-label="Close menu" class="rounded p-1 hover:bg-accent">
								@UIIcon("close", "h-5 w-5")
							</button>
						</div>
						@mobileNavLink("/projects", "Projects", activePage == "projects")
						@mobileNavLink("/about", "About", activePage == "about")
						@mobileNavLink("/curriculum", "CV", activePage == "curriculum")
						@mobileNavLink("/stack", "Stack", activePage == "stack")
						@mobileNavLink("/blog", "Blog", activePage == "blog")
						@mobileNavLink("/bookmarks", "Garden", activePage == "bookmarks")
						@mobileNavLink("/play", "Play", activePage == "play")
						@mobileNavLink("/stats", "Live", activePage == "stats")
						<div class="mt-2 flex flex-col gap-2 border-t border-border pt-4">
							<a href="/proposal" @click="open=false" class="inline-flex items-center justify-center gap-2 rounded-full bg-foreground px-4 py-2 text-center text-sm font-semibold text-background">
								Request proposal
								@UIIcon("arrow-right", "h-4 w-4")
							</a>
							<a href="mailto:fernandocorreia316@gmail.com" @click="open=false" class="inline-flex items-center justify-center gap-2 rounded-full border border-border px-4 py-2 text-center text-sm font-semibold">
								Email
								@UIIcon("mail", "h-4 w-4")
							</a>
						</div>
					</nav>
				</div>
			</div>
		</div>
	</nav>
}

templ navLink(href, label string, active bool) {
	if active {
		<a href={ templ.SafeURL(href) } class="rounded-full bg-accent px-3 py-1.5 text-sm font-medium">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class="rounded-full px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">{ label }</a>
	}
}

templ mobileNavLink(href, label string, active bool) {
	if active {
		<a href={ templ.SafeURL(href) } class="block rounded-md bg-accent px-3 py-2 text-sm font-medium">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class="block rounded-md px-3 py-2 text-sm text-muted-foreground hover:bg-accent hover:text-foreground">{ label }</a>
	}
}
