[Unit]
Description=Pull Obsidian vault from Hermes into the site vault directory
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The remote path is "/" because the key on Hermes is restricted with
# rrsync -ro /root/.hermes/obsidian-vault/FACorreia/raw/ — rrsync resolves
# requested paths relative to that directory.
ExecStart=/usr/bin/rsync -az --delete \
  --exclude='.*' \
  --exclude='*sync-conflict*' \
  --exclude='*.tmp' \
  -e "ssh -i /root/.ssh/id_ed25519_vault_sync -o StrictHostKeyChecking=accept-new -o ConnectTimeout=15" \
  root@78.46.192.73:/ \
  /opt/facorreia-site-go/vault/raw/
