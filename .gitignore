# air's scratch directory. tmp/main is a ~34MB compiled binary that every local
# `go run` rewrites, so tracking it dirtied the tree constantly and is most of
# why .git grew to 81MB.
tmp/

# --- Build output: never commit a binary. ---
# CI enforces this by file content (.github/workflows/no-binaries.yml); these
# entries keep the usual outputs from ever being staged.
bin/
tmp/
.build/
*.exe
*.test
*.o
*.a
*.so
*.dylib
/air
/golangci-lint
/main
/myapp
/server
/sqlc
