# Reference Caddyfile for the homepage server (/etc/caddy/Caddyfile).
# Canonical host is the apex domain — matches what search engines have
# indexed from the Swift-era site. Do not flip the redirect direction
# without also changing ui/layouts/canonical.go.
#
# Caddy 2.11 serves HTTP/1.1 + HTTP/2 + HTTP/3 by default and auto-manages
# Let's Encrypt certificates (no certbot needed).
{
	email fernandocorreia316@gmail.com
	servers {
		protocols h1 h2 h3
	}
}

(security_headers) {
	header {
		# HSTS: force HTTPS for a year, including subdomains; preload-eligible.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		# Everything is same-origin and self-hosted. 'unsafe-inline' +
		# 'unsafe-eval' are required by the inline bootstrap scripts and
		# Alpine.js expression evaluation; object-src/base-uri/frame-ancestors
		# stay locked down. worker-src blob: covers three.js if it spawns one.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
		# Drop server fingerprint.
		-Server
	}
}

www.facorreia.com {
	import security_headers
	redir https://facorreia.com{uri} permanent
}

facorreia.com {
	import security_headers
	encode zstd gzip

	reverse_proxy /assets/* localhost:8090 {
		header_down Cache-Control "public, max-age=31536000, immutable"
	}
	reverse_proxy localhost:8090
}
