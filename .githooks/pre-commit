#!/usr/bin/env bash
# Format and lint Go before allowing a commit.
# Bypass with: git commit --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! command -v gofumpt >/dev/null 2>&1; then
  echo "pre-commit: gofumpt not found on PATH" >&2
  exit 1
fi

if ! command -v golangci-lint >/dev/null 2>&1; then
  echo "pre-commit: golangci-lint not found on PATH" >&2
  exit 1
fi

echo "gofumpt -w ."
gofumpt -w .

# If gofumpt rewrote staged Go files, abort so the commit does not
# snapshot the unformatted versions still in the index.
rewritten=0
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  if ! git diff --quiet -- "$file"; then
    echo "pre-commit: gofumpt rewrote $file — stage it and commit again" >&2
    rewritten=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.go')

if [[ "$rewritten" -ne 0 ]]; then
  exit 1
fi

echo "golangci-lint run"
golangci-lint run
